NODE_ENV=DEV

# SERVER
PORT=3000
# Leave empty for direct access. Behind a reverse proxy, list ONLY trusted proxy IPs/CIDRs.
# Never trust arbitrary X-Forwarded-For headers from clients.
TRUST_PROXY=

WEB_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# JWT
JWT_SECRET=

# DATABASE
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=todo_dev_password
DB_DATABASE=TODO_DEV
DB_AUTO_SYNC=true
