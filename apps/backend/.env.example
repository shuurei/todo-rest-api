NODE_ENV=EXAMPLE

# SERVER
PORT=3000
# Exact frontend origins, separated by commas (no trailing slash).
# Required in production. If omitted in DEV, localhost defaults are used.
WEB_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT
JWT_SECRET=

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=TODO_DEV
DB_AUTO_SYNC=true