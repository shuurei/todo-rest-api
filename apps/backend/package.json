{
	"name": "backend",
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/app.ts",
		"db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/db.ts",
		"users:purge": "tsx src/commands/purge-users.ts",
		"db:up": "docker compose up -d db",
		"db:down": "docker compose stop db",
		"db:restart": "docker compose restart db",
		"db:logs": "docker compose logs -f db",
		"db:remove": "docker compose down"
	},
	"dependencies": {
		"@todo/shared": "workspace:*",
		"argon2": "^0.45.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"croner": "^11.0.0",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.3",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^1.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}