{
	"name": "@nodus/backend",
	"version": "0.0.0",
	"description": "Nodus REST API and WebSocket gateway",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/app.ts",
		"db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/db.ts",
		"db:up": "docker compose up -d --wait db",
		"db:down": "docker compose stop db",
		"db:restart": "docker compose restart db",
		"db:logs": "docker compose logs -f db",
		"db:remove": "docker compose down"
	},
	"dependencies": {
		"@nodus/shared": "workspace:*",
		"argon2": "^0.45.2",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.3",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.5.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"sharp": "^0.35.5",
		"typeorm": "^1.1.2",
		"ws": "^8.22.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}