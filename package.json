{
	"name": "nodus",
	"version": "0.0.0",
	"description": "Nodus personal workspace monorepo",
	"private": true,
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"db:up": "pnpm --filter @nodus/backend db:up",
		"db:down": "pnpm --filter @nodus/backend db:down",
		"db:restart": "pnpm --filter @nodus/backend db:restart",
		"db:logs": "pnpm --filter @nodus/backend db:logs",
		"db:remove": "pnpm --filter @nodus/backend db:remove"
	},
	"devDependencies": {
		"turbo": "^2.11.10"
	},
	"packageManager": "pnpm@12.15.0"
}